# Kernel config fragment: Anbernic RG34XX-SP (Allwinner H700), Ubuntu 24.04 (ReduxOS) userspace.
# Applied on top of arm64 defconfig by kernel/build-kernel.sh, after a generated fragment that
# turns off every other ARCH_* platform. Base: torvalds/linux 97d73c8 + kernel/patches/.
# DRAFT, NOT BOOTED. Every option below says where the need comes from.

## Reproducible name: kernel release = <version>-rg34xxsp, with no git hash of the local
## patch commits (those change with every git am).
# CONFIG_LOCALVERSION_AUTO is not set

## Trim: this SoC has no PCIe, no ACPI firmware, and a handheld does not host virtual machines.
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set

## Board drivers missing from defconfig. Found by tools/dt_driver_coverage.py on the redux DTB:
## each enabled node with no driver in defconfig.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=m
CONFIG_IIO_MUX=m
CONFIG_SUN20I_GPADC=m
CONFIG_SND_SUN4I_CODEC=m
CONFIG_AXP20X_ADC=m
CONFIG_AXP20X_POWER=m
CONFIG_BATTERY_AXP20X=m
CONFIG_SUN50I_IOMMU=y
CONFIG_SUN50I_H6_PRCM_PPU=y
# Video engine (Cedrus, staging; needs V4L2). Hardware decode for media players, optional.
# Media: only platform devices (Cedrus) and HDMI-CEC; no cameras, TV, radio, SDR or USB media,
# and no automatic tuner sub-drivers.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# CONFIG_MEDIA_CAMERA_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_USB_SUPPORT is not set
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=m

## Input: the frontend reads evdev; joydev for older SDL/emulator paths.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
# Power key: the AXP717 PEK is an MFD cell with no DT node, so tools/dt_driver_coverage.py cannot
# see it and defconfig leaves it off. Without it the kernel reports no KEY_POWER at all.
CONFIG_INPUT_AXP20X_PEK=m

## Wi-Fi and Bluetooth, RTL8821CS (board DT: rtw88 on mmc1, BT on UART1). Modules,
## firmware from noble's linux-firmware-realtek, which ships .zst files. No EXTRA_FIRMWARE.
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
# Other vendors' UART Bluetooth protocols: not on this board.
# CONFIG_BT_HCIUART_BCM is not set
# CONFIG_BT_HCIUART_QCA is not set
# CONFIG_BT_HCIUART_MRVL is not set
# CONFIG_BT_HCIUART_LL is not set
CONFIG_BT_RTL=m
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

## iwd 2.14 (noble's version), the Wi-Fi daemon ReduxOS uses: every option its start-up check
## lists (src/main.c check_crypto(), ADD_MISSING; tag 2.14, commit 42b4da1). Built in, not modules.
## Without CRYPTO_USER_API_HASH or CRYPTO_USER_API_SKCIPHER iwd exits at start-up; the others
## disable features (KEY_DH_OPERATIONS: WPS; the key parsers: WPA-Enterprise/TLS).
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_X509_CERTIFICATE_PARSER=y

## Handheld features (not board hardware), so common use doesn't need a custom kernel:
# SD cards over 32 GB (SDXC) come formatted exFAT; games often live there.
CONFIG_EXFAT_FS=m
CONFIG_USB_UAS=m
# Bluetooth input: BlueZ 5.72 (noble) opens /dev/uhid for HID and LE controllers
# (src/shared/uhid.c, profiles/input/hog-lib.c and device.c; tag 5.72, commit 770ad56).
CONFIG_UHID=m
# Emulator frontends and remappers create virtual pads through uinput.
CONFIG_INPUT_UINPUT=m
# Add-on controllers over USB or Bluetooth, with rumble and battery level.
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_STEAM=m
CONFIG_HID_BATTERY_STRENGTH=y

## Memory: zram swap for the 512 MB tier (noble's virtual kernel lacked zram.ko).
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

## systemd v255 (noble) README "REQUIREMENTS" (tag v255, db11bab): required options.
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
## Same README, optional features we want: automount, sandboxing, systemd-oomd (PSI), cgroup BPF.
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
# Not in the v255 list; kept because device ACLs (logind "uaccess") on /dev need it [inferred].
CONFIG_TMPFS_POSIX_ACL=y

## Boot and storage: FAT /boot (extlinux) and ext4 root on microSD.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y

## Host firewall (ReduxOS manifest, docs/reduxos-distro-build.md §3): nftables, deny inbound by
## default. arm64 defconfig has no packet filter that works on this kernel (nf_tables off, and
## the legacy iptables tables need NETFILTER_XTABLES_LEGACY, also off). NAT/masquerade are for a
## later Wi-Fi hotspot.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
