# SPDX-License-Identifier: GPL-2.0-only
# LPDDR3 boards (revised RG34XX-SP), merged after rg34xxsp.config by uboot/build-uboot.sh --dram lpddr3.
# DRAFT, NOT BOOTED.
# Drive/ODT values (DX_ODT, DX_DRI, CA_DRI, ODT_EN, TPR6, TPR10) are the LPDDR3 electrical parameters the
# vendor's boot0 uses on these boards (the same in every vendor LPDDR3 parameter set; PROVENANCE.md,
# category B). TPR11/TPR12 (training delays) are the values ROCKNIX ships for mainline's H616 LPDDR3 driver
# (tag 20261101, cefc143, u-boot-DDR3 anbernic_rg35xx_h700_lpddr3_defconfig).
# Needs u-boot with "sunxi: H616: dram: fix LPDDR3 TPR6 parsing" (Andre Przywara, accepted 2026-04-27; in v2026.10).
# DCDC3 1.20 V: LPDDR3's VDD. WRONG-SPL RISK: on an LPDDR4 board this gives 1.2 V to 1.1 V memory.
# CONFIG_SUNXI_DRAM_H616_LPDDR4 is not set
CONFIG_SUNXI_DRAM_H616_LPDDR3=y
CONFIG_DRAM_SUNXI_DX_ODT=0x06060606
CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
CONFIG_DRAM_SUNXI_CA_DRI=0x1919
CONFIG_DRAM_SUNXI_ODT_EN=0x9988eeee
CONFIG_DRAM_SUNXI_TPR6=0x2fb08080
CONFIG_DRAM_SUNXI_TPR10=0x402f4489
CONFIG_DRAM_SUNXI_TPR11=0x10121013
CONFIG_DRAM_SUNXI_TPR12=0x0d0e0d0e
CONFIG_AXP_DCDC3_VOLT=1200
