# SPDX-License-Identifier: GPL-2.0-only
# u-boot config fragment for the RG34XX-SP, merged onto mainline u-boot's
# anbernic_rg35xx_h700_defconfig by uboot/build-uboot.sh. DRAFT, NOT BOOTED.
# The defconfig already gives: H616 SPL with LPDDR4 @ 672 MHz, AXP717 (DCDC2 0.94 V GPU/sys rail,
# DCDC3 1.10 V DRAM), environment in FAT (uboot.env, 64 KiB) on the boot device's FAT partition.

## Device tree by panel ID (uboot/patches/0001). Until the display layer lands in kernel/, both panel
## revisions boot the tree without display nodes (-redux.dtb); the panel tree replaces PE6_LOW then.
CONFIG_ANBERNIC_RG34XXSP_DT_SELECTION=y
CONFIG_ANBERNIC_RG34XXSP_DT_PE6_LOW="allwinner/sun50i-h700-anbernic-rg34xx-sp-redux.dtb"
CONFIG_ANBERNIC_RG34XXSP_DT_PE6_HIGH="allwinner/sun50i-h700-anbernic-rg34xx-sp-redux.dtb"

## Kernel rollback (image/rootfs: zzz-h700-fallback, h700-boot-ok): count boots only while
## upgrade_available=1; after 3 failed tries boot the fallback menu.
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv bootlimit 3; setenv altbootcmd 'echo ReduxOS: boot limit reached, booting fallback; setenv upgrade_available 0; setenv bootcount 0; setenv fallback_used 1; saveenv; sysboot mmc 0:1 fat ${scriptaddr} /extlinux/extlinux-fallback.conf'; if env exists upgrade_available; then; else setenv upgrade_available 0; setenv bootcount 0; saveenv; fi"
CONFIG_CMD_SYSBOOT=y

## Version string "2026.10-rg34xxsp", without git hash or "-dirty" (reproducible builds)
CONFIG_LOCALVERSION="-rg34xxsp"
# CONFIG_LOCALVERSION_AUTO is not set
