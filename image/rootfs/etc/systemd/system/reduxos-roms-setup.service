[Unit]
Description=ReduxOS game folder tree + BIOS drop-in structure
After=local-fs.target
ConditionPathExists=/usr/local/bin/redux-setup-roms
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/redux-setup-roms /roms
[Install]
WantedBy=multi-user.target
