[Unit]
Description=ReduxOS codec mixer baseline
After=sound.target alsa-restore.service
Wants=sound.target
ConditionPathExists=/usr/local/sbin/reduxos-audio-init.sh
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/reduxos-audio-init.sh
[Install]
WantedBy=multi-user.target
